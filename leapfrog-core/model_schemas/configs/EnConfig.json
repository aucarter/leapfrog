{
  "name": "En",
  "long_name": "Entrants",
  "namespace": "en",
  "enable_if": "run_static_entrants",
  "state_space": {
    "default": {}
  },
  "pars": {
    "entrant_hiv_prevalence": {
      "num_type": "real_type",
      "dims": ["SS::NS", "opts.proj_steps"],
      "alias": {
        "r": "entrantprev"
      }
    },
    "entrant_art_coverage": {
      "num_type": "real_type",
      "dims": ["SS::NS", "opts.proj_steps"],
      "alias": {
        "r": "entrantartcov"
      }
    },
    "entrant_cd4_distribution": {
      "num_type": "real_type",
      "dims": ["SS::hDS", "SS::NS", "opts.proj_steps"],
      "alias": {
        "r": "paedsurv_cd4dist"
      }
    },
    "entrant_art_cd4_distribution": {
      "num_type": "real_type",
      "dims": ["SS::hTS", "SS::hDS", "SS::NS", "opts.proj_steps"],
      "alias": {
        "r": "paedsurv_artcd4dist"
      }
    },
    "entrant_paediatric_survival": {
      "num_type": "real_type",
      "dims": ["opts.proj_steps"],
      "alias": {
        "r": "paedsurv_lag"
      }
    },
    "entrant_net_migration": {
      "num_type": "real_type",
      "dims": ["SS::NS", "opts.proj_steps"],
      "alias": {
        "r": "cumnetmigr"
      }
    },
    "entrant_net_migration_hiv_prob": {
      "num_type": "real_type",
      "alias": {
        "r": "netmig_hivprob"
      }
    }
  },
  "intermediate": {
    "births_by_fertility_age": {
      "num_type": "real_type",
      "dims": ["SS::hAG_fertility"]
    }
  },
  "state": {
    "pregprev_lag": {
      "num_type": "real_type",
      "dims": ["SS::p_idx_hiv_first_adult"]
    }
  }
}
